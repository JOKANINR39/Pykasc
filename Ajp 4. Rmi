import java.rmi.*;

public class Client {

    public static void main(String args[]) {
        try {
            Add obj = (Add) Naming.lookup("rmi://localhost/AddService");

            int result = obj.add(10, 20);
           
            System.out.println("Sum = " + result);
        } catch (Exception e) {
            System.out.println(e);
        }
    }
}


